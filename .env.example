# Пример переменных окружения LandingMN — коммитится в репозиторий.
# НЕ содержит реальных секретов. Скопируй в .env.local и заполни реальными
# значениями (.env.local в .gitignore, никогда не коммитится).

# Базовый URL сайта — используется Astro.site (canonical/hreflang) и i18n-роутингом.
PUBLIC_SITE_URL=https://landingmn.pages.dev

# --- Контактные ссылки ---
# PUBLIC_TG_CONTACT_URL — реальный @username менеджера, получен от заказчика
# 19.08.2026 (круг правок 12, CLIENT-EDITS.md §9). Больше не заглушка.
# PUBLIC_MESSENGER_URL остаётся заглушкой (решение заказчика 09.08.2026):
# страница Facebook у заказчика ещё в процессе создания. Значение ниже
# заведомо фальшивое (слово PLACEHOLDER) и обязано быть заменено перед
# боевым запуском — искать по `grep -rn PLACEHOLDER`.
PUBLIC_MESSENGER_URL=https://m.me/PLACEHOLDER_FB_PAGE
PUBLIC_TG_CONTACT_URL=https://t.me/Example_Manager

# --- Адрес Telegram-БОТА (не менеджера) ---
# Пустая строка — по-прежнему штатное состояние: конверсионные кнопки ведут на
# PUBLIC_TG_CONTACT_URL выше и метку `?start=` не несут. Так и задумано:
# параметр `?start=` работает ТОЛЬКО со ссылками на бота, а на аккаунте живого
# человека Telegram молча его игнорирует.
#
# ✅ БОТ ПОЯВИЛСЯ 22.08.2026 (Фаза 6): @melbet_mn_bot, воркер landingmn-bot,
# вебхук зарегистрирован (план 06-05, docs/ops.md §8).
#
# ГДЕ АДРЕС ЖИВЁТ НА САМОМ ДЕЛЕ: в переменной репозитория GitHub
# PUBLIC_TG_BOT_URL (Settings → Secrets and variables → Actions → Variables),
# откуда её берут .github/workflows/ci.yml и deploy.yml. Это ЕДИНСТВЕННОЕ
# место, которое имеет значение для боевой сборки: PUBLIC_* подставляются
# astro:env литералом во время `npm run build` на раннере GitHub. Для локальной
# работы значение кладётся в .env.local (он в .gitignore).
#
# ПОЧЕМУ ЗНАЧЕНИЕ НЕ ВПИСАНО СЮДА. Этот файл — шаблон, а шаблон копируют, в том
# числе при клонировании лендинга под новое гео (INFRA-03). Унаследованный
# отсюда адрес чужого бота означал бы, что клон под другую страну молча ведёт
# своих посетителей в МОНГОЛЬСКОГО бота и сажает их лиды в монгольский чат
# менеджеров: страница работает, кнопки нажимаются, лиды уходят не туда. Тот же
# приём уже применён к PUBLIC_GA_ID и PUBLIC_TURNSTILE_SITEKEY выше — и по той
# же причине (митигация T-06-34).
#
# ⚠️ ПОЭТОМУ ЖЕ ЭТОТ ФАЙЛ НЕЛЬЗЯ ЧИТАТЬ КАК ИСТОЧНИК ЗНАЧЕНИЯ В ТЕСТАХ.
# `.env.example` не читает ВООБЩЕ НИКТО, кроме человека: Astro берёт `.env` и
# `.env.local`, а в CI — переменные окружения workflow (измерено 22.08.2026:
# без .env.local сборка падает с «PUBLIC_SITE_URL is missing», хотя значение
# стоит здесь). Тест, читавший этот файл, сверял бы себя с тем, чего сборка не
# видела — разбор в шапке scripts/lib/env-value.ts.
PUBLIC_TG_BOT_URL=

# --- Идентификаторы аналитики. ВЫДАНЫ 21.08.2026 ---
# Measurement ID GA4 и Project ID Clarity получены от заказчика. Значения
# ЗДЕСЬ НАМЕРЕННО НЕ ПРОСТАВЛЕНЫ, и это не забывчивость — см. ниже.
#
# ГДЕ ОНИ ЖИВУТ НА САМОМ ДЕЛЕ: в переменных репозитория GitHub
# (Settings -> Secrets and variables -> Actions -> Variables), откуда их берут
# .github/workflows/ci.yml и deploy.yml. Это ЕДИНСТВЕННОЕ место, которое имеет
# значение для боевой сборки: PUBLIC_* подставляются astro:env литералом во
# время `npm run build` на раннере GitHub. Процедура и снимок «до/после» —
# docs/ops.md §7. В переменные проекта Cloudflare Pages их писать бесполезно:
# `wrangler pages deploy ./dist` грузит уже собранный каталог.
#
# ПОЧЕМУ ЗНАЧЕНИЯ НЕ ВПИСАНЫ В ЭТОТ ФАЙЛ. Он шаблон, а шаблон копируют — в том
# числе при клонировании лендинга под новое гео (INFRA-03). Унаследованный
# отсюда чужой Measurement ID означал бы, что клон молча шлёт данные в счётчик
# Монголии: страница работает, счётчик считает, просто не тот. Ровно от этого
# класса ошибок стоит гейт check:analytics-config, и класть приманку в файл по
# соседству с ним — плохая идея. Тот же приём уже применён к
# PUBLIC_TURNSTILE_SITEKEY ниже. Для локальной работы значения кладутся в
# .env.local (он в .gitignore).
#
# ПУСТО = ВЫКЛЮЧЕНО, и это по-прежнему штатное состояние: чанк провайдеров
# вырезается сборщиком целиком — ноль запросов к googletagmanager.com и
# clarity.ms, ноль их байт в dist/. Проверяется тестами в tests/analytics.spec.ts,
# причём с 21.08.2026 — на СОБСТВЕННОЙ сборке с явно пустыми значениями, а не
# на общем dist/ (иначе тесты падали бы у всех, у кого .env.local заполнен).
#
# ⚠️ Забыть вписать нельзя: `npm run check:analytics-config` валит сборку, как
# только PUBLIC_SITE_URL указывает на боевой домен, а PUBLIC_GA_ID пуст.
# На превью (*.pages.dev, localhost) он только предупреждает.
#
# ✅ Clarity ВКЛЮЧЁН 21.08.2026 (план 03-11). Переменная репозитория
# PUBLIC_CLARITY_ID задана, боевая сборка идёт с тегом записей сессий.
#
# Что изменилось с тех пор, как здесь стояло «выдан, но НЕ включён»: заказчик
# выключил установку cookies в кабинете Clarity, а проект стал сообщать тегу
# состояние согласия (`consentv2` уходит первым и ДО вставки тега —
# src/scripts/analytics/clarity.ts). Замер после: сторонних cookies clarity.ms /
# bing.com НОЛЬ при доказанно загруженном теге, best-practices 77 → 96.
#
# Разбор и история решения — docs/ops.md §7.4 (раздел приводится в
# соответствие планом 03-12), числа замеров — 03-11-SUMMARY.md.
#
# ⚠️ Откат стоит одной команды и НЕ требует правок кода:
#     gh variable delete PUBLIC_CLARITY_ID
# Пустое значение — штатное «выключено», чанк провайдеров вырезается целиком.
#
# ⚠️ Переключатель cookies живёт В ЧУЖОМ КАБИНЕТЕ и может быть возвращён одним
# кликом без нашего ведома. Единственная защита при таком откате — наш сигнал
# `consentv2` перед тегом; его порядок стережёт npm run check:analytics-config
# (проверка 3) и два случая саботажного стенда. Убирать его как «избыточный» нельзя.
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=

# --- Turnstile: публичный ключ виджета. Пусто до Фазы 5 ---
# ПУСТО = ВЫКЛЮЧЕНО, и это штатное состояние всей Фазы 4, а не незавершённость.
# Пока здесь пусто: ноль запросов к challenges.cloudflare.com, ноль его байт в
# dist/, ноль виджетов на странице. Бэкенд /api/lead разрабатывается и
# проверяется именно так — с выключенным антиспамом, детерминированно.
#
# Виджет включает Фаза 5 заполнением ЭТОЙ ОДНОЙ переменной — правок кода не
# требуется ни одной. Боевой ключ уже создан планом 04-01 и лежит в аккаунте
# Cloudflare (виджет `landingmn-lead-form`, домены landingmn.pages.dev и
# partner-melbet.com); достать его: Turnstile → виджет → Sitekey.
#
# ⚠️ Забыть включить нельзя: `npm run check:turnstile-config` (план 04-04) валит
# БОЕВУЮ сборку с пустым значением, ровно как check:analytics-config валит её с
# пустым PUBLIC_GA_ID. На превью и localhost — только предупреждение.
#
# ⚠️ Имя переменной трогать нельзя. Окончание `_SITEKEY` выбрано так, чтобы не
# попасть под шаблон гейта check:secrets (план 04-03), который ищет имена,
# кончающиеся на _TOKEN / _SECRET / _KEY / CHAT_ID. PUBLIC_TURNSTILE_KEY сломал
# бы гейт и одновременно соврал бы о содержимом: ключ здесь публичный.
PUBLIC_TURNSTILE_SITEKEY=

# --- ТЕСТОВЫЕ ключи Turnstile от Cloudflare. Справка, а не конфигурация ---
# Публичные, задокументированные, одинаковые у всех. Здесь они НЕ присваиваются
# переменным намеренно: в .env.example живёт только то, что читает СБОРКА, а
# секрет Turnstile читает серверная функция из context.env. Для локальных
# запусков `wrangler pages dev` секрет кладётся в .dev.vars (он в .gitignore),
# БОЕВОЙ — только в Pages Secrets, и только планом 04-11.
#
#   sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
#       → всегда «прошёл»
#   sitekey 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
#       → всегда «отказ» (invalid-input-response)
#   sitekey 3x00000000000000000000FF / secret 3x0000000000000000000000000000000AA
#       → израсходованный токен (timeout-or-duplicate)
#
# ⚠️ ЛОВУШКА, НАЙДЕННАЯ ЗАМЕРОМ, А НЕ ПРОЧИТАННАЯ В ДОКУМЕНТАЦИИ: секрет
# 1x…AA возвращает success: true даже на заведомо мусорный токен (проверено
# живым POST на siteverify со строкой `garbage`). Значит позитивный тест на нём
# НЕ ДОКАЗЫВАЕТ, что токен вообще отправляется, — он пройдёт и у функции,
# которая поле response потеряла. Такой тест обязан идти В ПАРЕ с двумя
# негативными: 2x…AA (должно быть отклонено) и запрос БЕЗ поля response
# (missing-input-response). Поодиночке первый случай не проверяет ничего.
