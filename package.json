{
  "name": "landingmn",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --experimental-strip-types scripts/build-csp.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-completeness.ts",
    "check:i18n:bot": "node --experimental-strip-types scripts/check-i18n-completeness.ts --dir workers/bot/i18n --set bot",
    "check:hreflang": "node --experimental-strip-types scripts/check-hreflang.ts",
    "check:seo": "node --experimental-strip-types scripts/check-seo.ts",
    "check:perf": "node --experimental-strip-types scripts/check-perf-budget.ts",
    "check:motion-safety": "node --experimental-strip-types scripts/check-motion-safety.ts",
    "check:mask-safety": "node --experimental-strip-types scripts/check-mask-safety.ts",
    "check:craft-contract": "node --experimental-strip-types scripts/check-craft-contract.ts",
    "test": "playwright test",
    "check:font": "node --experimental-strip-types scripts/check-font-coverage.ts",
    "check:links": "node --experimental-strip-types scripts/check-links.ts",
    "check:csp": "node --experimental-strip-types scripts/check-csp.ts",
    "check:lighthouse": "node --experimental-strip-types scripts/run-lighthouse.ts",
    "check:placeholders": "node --experimental-strip-types scripts/check-placeholders.ts",
    "check:encoding": "node --experimental-strip-types scripts/check-encoding.ts",
    "check:dead-tokens": "node --experimental-strip-types scripts/check-dead-tokens.ts",
    "check:viewport-units": "node --experimental-strip-types scripts/check-viewport-units.ts",
    "check:start-codec": "node --experimental-strip-types scripts/check-start-codec.ts",
    "check:analytics-events": "node --experimental-strip-types scripts/check-analytics-events.ts",
    "check:analytics-config": "node --experimental-strip-types scripts/check-analytics-config.ts",
    "check:client-decisions": "node --experimental-strip-types scripts/check-client-decisions.ts",
    "check:sabotage": "node --experimental-strip-types scripts/check-sabotage.ts",
    "check:sabotage:full": "node --experimental-strip-types scripts/check-sabotage.ts --with-costly",
    "check:lead-unit": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\"",
    "check:lead-endpoint": "node --experimental-strip-types scripts/check-lead-endpoint.ts",
    "check:bot-webhook": "node --experimental-strip-types scripts/check-bot-webhook.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "check:lead-contract": "node --experimental-strip-types scripts/check-lead-contract.ts",
    "check:turnstile-config": "node --experimental-strip-types scripts/check-turnstile-config.ts",
    "media:clouds": "node --experimental-strip-types scripts/build-cloud-layer.ts",
    "media:texture": "node --experimental-strip-types scripts/build-scene-texture.ts",
    "make:start-link": "node --experimental-strip-types scripts/make-start-link.ts",
    "export:public": "node --experimental-strip-types scripts/export-public.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.1",
    "chrome-launcher": "1.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "lighthouse": "13.4.1",
    "playwright": "1.56.1",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.124.0"
  }
}
