// workers/bot/wrangler.jsonc — конфигурация ОТДЕЛЬНОГО воркера бота.
// Source: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// ⛔ ЭТО НЕ КОРНЕВОЙ `wrangler.jsonc`. Тот описывает проект Pages (лендинг и
// `/api/lead`): у него `pages_build_output_dir`, блок `env.preview` и три
// секрета приёма заявок. Воркер бота — отдельный деплой, и обращаются к нему
// флагом `-c workers/bot/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "landingmn-bot",
  "main": "index.ts",

  // ─── compatibility_date ───────────────────────────────────────────────────
  // Значение ПЕРЕНЕСЕНО из корневого `wrangler.jsonc`, где оно установлено
  // прогоном и подробно обосновано («ПРАВИЛО ДВУХ ПОТОЛКОВ» с четырьмя
  // замерами). Обоснование не пересказывается здесь намеренно: пересказ
  // разошёлся бы с оригиналом в первый же день его правки.
  //
  // ⛔ Гнаться за сегодняшним числом не нужно и вредно: `compatibility_date`
  // фиксирует НАБОР ПОВЕДЕНИЙ рантайма, а не «свежесть» проекта. Поднимать её
  // здесь можно только прогоном `wrangler dev -c workers/bot/wrangler.jsonc`, а
  // не арифметикой от текущей даты.
  "compatibility_date": "2026-08-19",

  // ─── Журнал и служебные записи бота ──────────────────────────────────────
  // Неймспейс ОБЩИЙ с журналом заявок формы, и это намеренно: свободный план,
  // разные префиксы ключей (`lead:` у формы, `bot:`, `botcd:`, `botupd:` у
  // бота), одна процедура разбора инцидента (`docs/ops.md` §2.1).
  //
  // ⛔ Блок `env.preview` сюда НЕ КОПИРУЕТСЯ. У воркера нет превью-деплоев
  // Pages, а правило ненаследуемых ключей, из-за которого блок существует в
  // корневом файле, здесь не применяется вовсе. Копия породила бы
  // конфигурацию, про которую никто не знает, применяется ли она.
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "00000000000000000000000000000000"
    }
  ],

  // Идентификатор версии для `/admin/diag`. Без него поле `config.version_id`
  // отвечало бы `null` всегда — то есть было бы заглушкой в диагностическом
  // ответе, по которому будут разбирать инцидент.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  // ─── Расписание мониторинга (MON-01, MON-03) ─────────────────────────────
  //
  // ДВА выражения, и они запускают РАЗНЫЕ пробы. Разветвление идёт по
  // `event.cron` в `workers/bot/index.ts` — по времени различить их нельзя в
  // принципе: в ноль минут каждого часа срабатывают ОБА, потому что `*/5`
  // включает нулевую минуту.
  //
  //   "*/5 * * * *"  ПРОБА ДОСТУПНОСТИ. Три GET-запроса к наблюдаемому сайту
  //                  (корень, /api/health, /api/lead). Пять минут выбраны как
  //                  верхняя граница обещания «алерт за минуты»: порог алерта —
  //                  ДВА неудачных цикла подряд, то есть первое сообщение
  //                  приходит через 10 минут после начала отказа. Один цикл
  //                  вместо двух сократил бы задержку вдвое и стоил бы
  //                  сообщения на каждом всхлипе сети — размен плохой, и
  //                  обоснование целиком лежит в шапке workers/bot/monitor.ts.
  //
  //   "0 * * * *"    ПРОБА «НОЛЬ ЛИДОВ ПРИ НЕНУЛЕВЫХ ПОПЫТКАХ». Раз в час, и
  //                  ЧАЩЕ НЕ НАДО — это не осторожность, а замер. Живая выборка
  //                  KV 26.08.2026: 8 конверсий за 50 ч 55 мин, максимальный
  //                  промежуток между двумя — 24 ч 04 мин при исправном сайте.
  //                  На таком темпе окно короче часа не добавляет ни одного
  //                  наблюдения, зато каждый лишний запуск стоит обхода журнала
  //                  по шести префиксам и чтения шести вёдер счётчика — то есть
  //                  расхода лимитов KV, общих со страховкой от потери лида.
  //
  // ⛔ ВЫРАЖЕНИЯ ПРОДУБЛИРОВАНЫ В КОДЕ (`UPTIME_CRON` / `NO_LEADS_CRON` в
  // workers/bot/monitor-run.ts), и разойтись они не имеют права: код
  // сравнивает `event.cron` с этими строками БУКВАЛЬНО. Правка здесь без правки
  // там означает, что часовая проба навсегда уходит в ветку пятиминутной, — и
  // отказ этот МОЛЧАЛИВЫЙ: воркер продолжает работать, а алерт MON-03 не
  // срабатывает никогда.
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *"]
  }

  // ⛔ АДРЕС ЖИВОГО МЕНЕДЖЕРА В ЭТОТ ФАЙЛ НЕ ВПИСЫВАЕТСЯ, И `vars` ЗДЕСЬ НЕТ
  // ВОВСЕ. Технически `vars` в этом файле разрешён (запрет `docs/ops.md` §6.6
  // относится к КОРНЕВОМУ файлу, где `env.preview` переопределяет
  // `kv_namespaces`). Отвергнуто по другой причине: этот адрес УЖЕ живёт в
  // проекте как `PUBLIC_TG_CONTACT_URL`, и он уже менялся однажды —
  // 19.08.2026, круг правок 12. Литерал в отслеживаемом файле создал бы второй
  // источник правды об одном факте, без единого сверяющего гейта, а CLAUDE.md
  // требует ровно обратного: «смена контакта/домена без переработки кода».
  //
  // Значение задаётся ПЕРЕМЕННОЙ ВОРКЕРА из командной строки при вооружении
  // (флаг `--var` с именем, объявленным в `BotEnv` — `workers/bot/webhook.ts`;
  // план 06-05), и берётся оно из ТОЙ ЖЕ переменной репозитория
  // `PUBLIC_TG_CONTACT_URL`, из которой его берёт сайт: источник правды ОДИН,
  // мест применения два.
  //
  // ⚠️ Само ИМЯ переменной здесь тоже не пишется — ни в одной строке, включая
  // эти комментарии. Проверка плана буквальна: `grep -c` по имени обязан дать
  // ноль, и оговорка «но у нас оно только в комментарии» превратила бы точную
  // пробу в пробу «на глаз».
  //
  // ⚠️ `wrangler deploy` приводит `vars` к объявленному, поэтому флаг стоит в
  // САМОМ шаге выкладки. Наблюдаемость обеспечивает `/admin/diag`: он отдаёт
  // действующее значение (оно не секрет — тот же адрес видит каждый посетитель
  // в HTML), поэтому расхождение сайта и бота обнаруживается одним запросом, а
  // не по жалобе.
}
