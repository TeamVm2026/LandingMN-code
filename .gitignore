# Искажённые копии модулей, которые создаёт саботажный стенд
# (npm run check:sabotage). Живут доли секунды и удаляются в teardown();
# правило здесь на случай прерванного прогона — стенд сверяет чистоту
# рабочего дерева и обязан падать на СВОИХ следах, а не на этих.
.sabotage-tmp/

# Черновой каталог разовых замеров (кадры сравнения с макетом, пробы
# наклона, пипетки контраста). Существовал и раньше, но НЕ был объявлен ни
# здесь, ни в eslint.config.js, и ловил на себе сразу два правила проекта:
# `git status --porcelain` переставал быть пустым перед коммитом (процессное
# правило 1), а `npm run lint` падал на браузерных глобалях внутри разовых
# .mjs. Каталог в сборку не входит и в репозитории ему делать нечего.
.tmp-work/

# Сборка с искусственными идентификаторами аналитики. Её делает и удаляет
# tests/analytics.spec.ts: при пустых ID чанк провайдеров вырезан сборщиком,
# и проверить момент их загрузки на обычной сборке физически нечем.
dist-analytics/
dist-empty-analytics/

# Сборка для матрицы запроса согласия (tests/consent-banner.spec.ts). Каталог
# СВОЙ, а не общий с dist-analytics/: общий между двумя файлами дал бы
# гонку при параллельном прогоне — afterAll одного удалял бы дерево,
# из которого второй ещё отдаёт страницы.
dist-consent/

# служебный файл планировщика задач Claude Code
.claude/scheduled_tasks.lock

# Артефакт MCP-сервера extended-memory: он резолвит относительный путь
# внутрь проекта. Не код проекта, но без этого правила постоянно висит
# в git status и рискует попасть в коммит через git add -A.
/Users/

# Дизайн-пакет заказчика от 26.08.2026 (124 файла, 172 МБ PNG): макеты,
# ассеты слайдов, семь фонов по 1,6–11,2 МБ. ⛔ В git не попадает НИКОГДА:
# `.git` репозитория уже 179 МБ, а история необратима — вычистить потом
# можно только `git filter-repo`, который перепишет все SHA, на которые
# ссылаются SUMMARY девяти фаз. Каталог — источник истины по ВИДУ и живёт
# только на машине; в репозиторий уходят ТОЛЬКО обработанные лёгкие версии
# в src/assets/media/ (см. scripts/prepare-media.ts, ветка clientProvided).
# Без этого правила каталог висит в `git status --porcelain` и ломает две
# вещи: сверку files_modified перед коммитом и снимок дерева саботажного
# стенда, который даёт на чужой след ложный диагноз «нарушена изоляция».
Правки по дизайну с креативами/

# Второй пакет замены фото партнёров от 04.09.2026 (5 PNG с альфой, ~8.4 МБ):
# групповой кадр 4brata.png + четыре одиночных портрета. Тот же довод, что у
# каталога выше — в git не попадает, обработанные версии едут через
# scripts/prepare-media.ts (REPLACEMENT_PACK_DIR) в src/assets/media/.
Замена партнеров/

# Каталог разовых замеров Playwright: скрипты-пробники и кадры одного
# захода. Тот же класс, что .tmp-work/ — в сборку не входит, в репозиторий
# не нужен, а весит сотнями PNG. Объявлен и в eslint.config.js.
.playwright-mcp/

# ── Кадры разовых замеров заходов ─────────────────────────────────────────────
# Причина названа числом: на 07.09.2026 в .planning лежало 819 МБ изображений
# (2184 отслеживаемых на 762,4 МБ + 107 неотслеживаемых на 56,6 МБ), из них
# 820,9 МБ не упоминает ни один текст репозитория, а .git вырос до 936 МБ и уже
# НЕОБРАТИМ: вычистить кадры ИЗ ИСТОРИИ может только git filter-repo, который
# перепишет все SHA, на которые ссылаются SUMMARY девяти фаз, — это прямо
# запрещено правилом проекта. Кадр прогона — вывод прибора из tools/ того же
# захода; он воспроизводится, хранить его вечно незачем.
#
# ⚠️ Правило действует ТОЛЬКО ВПЕРЁД. Уже отслеживаемые 2184 изображения оно НЕ
# снимает с учёта — их снял git rm заходом 20260907-cleanup, и это не уменьшило
# .git ни на байт: из истории они никуда не делись (в том и смысл — откат возможен).
#
# ⛔ ДОГОВОРЁННОСТЬ О МЕСТЕ, а не запрет по маске: эталон приёмки кладётся в
# КОРЕНЬ каталога захода с префиксом approved-/etalon-, рабочий кадр — в
# подкаталог. Тогда правило физически не может оторвать эталон от строки,
# которая его цитирует.
#
# ⚠️ Запрет по РАСШИРЕНИЮ, а не по имени каталога — обе причины замерены:
# (1) перечень имён (shots/, probes-*/, kadry/, context/) ДЫРЯВ: кадры нашлись в
# after-bg/, которого в перечне нет, то есть накопление шло бы мимо правила;
# (2) исключённый КАТАЛОГ в git необратим — внутрь него git не спускается, и
# «!…/kadry/» уже не спасёт, а исключение по файлу спасает.
.planning/quick/**/*.png
.planning/quick/**/*.jpg
.planning/quick/**/*.jpeg
.planning/quick/**/*.webp
.planning/quick/**/*.avif
.planning/sketches/**/*.png
.planning/sketches/**/*.jpg
.planning/sketches/**/*.avif

# Исключения — эталоны и кадры, цитируемые поимённо CLAUDE.md и тестами.
# approved-*.jpg захода 20260906-cloud-bg читаются приборами НА ИСПОЛНЕНИИ
# (sverka-s-etalonom.mjs, steklo-vs-etalon.mjs, spine-line/vs-approved.mjs)
# и цитируются пятью тестами — без них утверждённый дизайн нечем принять.
!.planning/quick/*/approved-*.jpg
!.planning/quick/*/etalon-*.png
# Шесть файлов kadry/zamery захода 20260907-glass-lighter цитируются CLAUDE.md
# поимённо как обоснование границы <=5 / <=3,5.
!.planning/quick/20260907-glass-lighter/kadry/*.png
# Записи о правах на плиты фона: docs/media-credits.md:369,374 и
# scripts/prepare-media.ts:1953,1958 ссылаются на них как на доказательство
# лицензий CC0/PD. Удаление ломает доказательство происхождения.
!.planning/quick/20260902-desktop-layout/bg2/**
# Кадр, который цитирует ЖИВОЙ компонент src/components/HowToStart.astro:254.
# Найден прибором ssylki-v-pustotu.mjs 07.09.2026: его прятал ЛОКАЛЬНЫЙ .gitignore
# самого захода (probes/*.png), из-за чего он был невидим и для git status.
!.planning/quick/20260829-touch-form-steps/probes/node2.png

# Черновые HTML-стенды эскизов: не цитируются ни правилом, ни тестом, весят
# сотнями килобайт и живут ровно один заход. Уже отслеживаемые
# (000-hero-proof/index.html, 20260903-desktop-glass/sketch.html) правилом не
# затрагиваются — .gitignore не снимает с учёта.
.planning/sketches/**/*.html

# Собранный сайт внутрь каталога захода. Один такой случай уже был:
# 20260829-touch-form-steps/tools/build — 184 файла, 5 МБ, включая байт-в-байт
# копии public/og-*.png. Заход это заметил и завёл СВОЙ локальный .gitignore;
# правило здесь — чтобы следующему не пришлось.
.planning/quick/*/tools/build/

# Нумерованные попытки одного дня: exp2…exp13, shot1…shot3 — это перебор
# вариантов, а не инструмент.
# ⛔ БЛАНКЕТНОГО правила `.planning/quick/*/tools/*.mjs` здесь НЕТ НАМЕРЕННО, и
# отказ от него — главный вывод ревью 07.09.2026: прибор svip-chisto2.mjs,
# цитируемый CLAUDE.md, оказался ВНЕ git именно потому, что «пробник в tools/» и
# «прибор приёмки» по имени неотличимы. Бланкетное правило воспроизвело бы этот
# отказ на следующем приборе МОЛЧА. 548 КБ текста в истории дешевле повторения.
.planning/quick/*/tools/exp*.mjs
.planning/quick/*/tools/shot?.mjs
