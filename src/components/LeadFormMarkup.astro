---
import SceneLayer from './SceneLayer.astro';
import cloudsForm from '../assets/media/scene-clouds-form.webp';
import { t } from '../i18n/t';
import { config } from '../config';
import { PAGE_ROUTES, type Locale } from '../i18n/routes';

import { FIELDS, HONEYPOT_FIELD, ATTRIBUTION_FIELD } from '../lib/lead-contract';
import { buildContactHref } from '../lib/start-link';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const tgCtaHref = buildContactHref({
  botUrl: config.tgBotUrl,
  fallbackUrl: config.tgContactUrl,
  direction: 'none',
  locale,
});
---

<section class="lead-form" id="lead-form" aria-labelledby="lead-form-title">

  <SceneLayer
    src={cloudsForm}
    modifier="scene-layer--form"
    sizes="(max-width: 859px) 300vw, 130vw"
    widths={[900, 1400, 2000]}
    cover
  />
  <div class="lead-form__container">

    <div class="lead-form__head">
      <h2 id="lead-form-title" class="type-h2">{t(locale, 'form.title')}</h2>
      <p class="lead-form__lead type-body">{t(locale, 'form.lead')}</p>
    </div>

    <form
      class="lead-form__form"
      method="post"
      action="/api/lead"
      data-lead-form
      data-track-form="form"
      data-err-required={t(locale, 'form.err_required')}
      data-err-consent={t(locale, 'form.err_consent')}
      data-err-direction={t(locale, 'form.err_direction')}
      data-repeat-title={t(locale, 'form.repeat_title')}
      data-repeat-body={t(locale, 'form.repeat_body')}
      data-repeat-cta={t(locale, 'pages.thanks_cta')}
      data-repeat-reset={t(locale, 'form.repeat_reset')}
      data-repeat-href={tgCtaHref}
      data-success-title={t(locale, 'pages.thanks_h1')}
      data-label-submit={t(locale, 'form.submit')}
      data-label-submitting={t(locale, 'form.submitting')}
      data-api-err-validation={t(locale, 'api.err_validation')}
      data-api-err-captcha={t(locale, 'api.err_captcha')}
      data-api-err-rate-limited={t(locale, 'api.err_rate_limited')}
      data-api-err-generic={t(locale, 'api.err_generic')}
      data-api-err-network={t(locale, 'api.err_network')}
      data-api-fallback-cta={t(locale, 'api.fallback_cta')}
      data-api-fallback-href={tgCtaHref}
      data-err-invalid={t(locale, 'form.err_invalid')}
    >

      <input type="hidden" name={FIELDS.lang} value={locale} />
      <input type="hidden" name={ATTRIBUTION_FIELD} value="" />
      <input
        type="text"
        name={HONEYPOT_FIELD}
        hidden
        aria-hidden="true"
        tabindex="-1"
        autocomplete="off"
      />

      <fieldset class="field field--direction">
        <legend class="field__label type-label visually-hidden">{t(locale, 'form.label_direction')}</legend>
        <div class="chip-group">
          <label class="chip-radio">
            <input type="radio" name="direction" id="lead-direction-affiliate" value="affiliate" required />
            <span class="chip-radio__text">{t(locale, 'cards.affiliate.name')}</span>
          </label>
          <label class="chip-radio">
            <input type="radio" name="direction" id="lead-direction-bank" value="bank" required />
            <span class="chip-radio__text">{t(locale, 'cards.bank.name')}</span>
          </label>
          <label class="chip-radio">
            <input type="radio" name="direction" id="lead-direction-teamcash" value="teamcash" required />
            <span class="chip-radio__text">{t(locale, 'cards.teamcash.name')}</span>
          </label>
        </div>
      </fieldset>

      <div class="field field--name">
        <label class="field__label type-label visually-hidden" for="lead-name">
          {t(locale, 'form.label_name')}
        </label>
        <input
          class="field__input"
          type="text"
          id="lead-name"
          name="name"
          autocomplete="name"
          placeholder={t(locale, 'form.label_name')}
          required
        />
      </div>

      <fieldset class="field field--contact">

        <legend class="field__label type-label visually-hidden">{t(locale, 'form.label_contact')}</legend>

        <div class="chip-group">
          <label class="chip-radio">
            <input type="radio" name="contact_channel" value="phone" checked />
            <span class="chip-radio__text">{t(locale, 'form.contact_phone')}</span>
          </label>
          <label class="chip-radio">
            <input type="radio" name="contact_channel" value="telegram" />
            <span class="chip-radio__text">{t(locale, 'form.contact_telegram')}</span>
          </label>
          <label class="chip-radio">
            <input type="radio" name="contact_channel" value="messenger" />
            <span class="chip-radio__text">{t(locale, 'form.contact_messenger')}</span>
          </label>
        </div>

        <label class="visually-hidden" for="lead-contact">
          {t(locale, 'form.label_contact')}
        </label>
        <div class="field__contact-group">
          <span class="field__phone-prefix" aria-hidden="true">+976</span>
          <input
            class="field__input field__input--contact"
            type="text"
            id="lead-contact"
            name="contact"
            placeholder={t(locale, 'form.contact_placeholder')}
            data-contact-input
            data-hint-phone={t(locale, 'form.contact_hint_phone')}
            data-hint-telegram={t(locale, 'form.contact_hint_telegram')}
            data-hint-messenger={t(locale, 'form.contact_hint_messenger')}
            required
          />
        </div>
      </fieldset>

      <div class="consent-row">
        <label class="consent">
          <input type="checkbox" id="lead-consent" name="consent" required />
          <span class="type-body">
            {(() => {
              const text = t(locale, 'form.consent');
              const anchor = t(locale, 'form.consent_link');
              const at = text.indexOf(anchor);
              if (at < 0) return text;
              return (
                <>
                  {text.slice(0, at)}
                  <a
                    class="consent-link"
                    href={PAGE_ROUTES.privacy[locale]}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {anchor}
                  </a>
                  {text.slice(at + anchor.length)}
                </>
              );
            })()}
          </span>
        </label>
        {!t(locale, 'form.consent').includes(t(locale, 'form.consent_link')) && (
          <a
            class="consent-link consent-link--standalone type-body"
            href={PAGE_ROUTES.privacy[locale]}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t(locale, 'pages.privacy_title')}
          </a>
        )}
      </div>

      <div
        class:list={['lead-form__turnstile', { 'lead-form__turnstile--off': !config.turnstileSitekey }]}
        data-turnstile
      >
      </div>

      <button type="submit" class="btn btn-primary type-body-bold lead-form__submit">
        {t(locale, 'form.submit')}
      </button>

      <div class="lead-form__status" data-lead-status role="status" aria-live="polite" aria-atomic="true"></div>
    </form>
  </div>
</section>

<style>
  .lead-form > :global(.scene-layer--form) {
    --sl-top: -130px;
    --sl-h: calc(100% + 430px);
    --sl-w: 300%;
    --sl-opacity: 0.72;
    --sl-flip: scaleX(-1);
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 220px,
      #000 calc(100% - 300px),
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 220px,
      #000 calc(100% - 300px),
      transparent 100%
    );
  }

  @media (min-width: 860px) {
    .lead-form > :global(.scene-layer--form) {
      --sl-w: min(130%, max(100%, 1872px));
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0,
        #000 320px,
        #000 calc(100% - 480px),
        transparent 100%
      );
      mask-image: linear-gradient(
        180deg,
        transparent 0,
        #000 320px,
        #000 calc(100% - 480px),
        transparent 100%
      );
    }
  }

  .lead-form {

    position: relative;

    --form-h-field: 52px;
    --form-h-chip: 26px;

    --form-radius-field: calc(var(--form-h-field) / 8);

    --form-radius-seam: calc(var(--form-h-chip) / 16);

    --form-radius-press: var(--radius-pill);

    padding-block: var(--gap-section) var(--gap-section);
  }

  @media (min-width: 860px) {
    .lead-form {
      --form-h-chip: 40px;
    }

    .chip-radio__text {
      font-size: 13px;
    }
  }

  .lead-form__container {
    width: min(calc(100% - 48px), var(--page));
    margin-inline: auto;
  }

  .lead-form__container:has([data-lead-repeat]) .lead-form__lead,
  .lead-form__container:has([data-lead-success]) .lead-form__lead {
    display: none;
  }

  .lead-form__head {
    max-width: 46rem;
    margin-bottom: var(--gap-head);
  }

  @media (min-width: 860px) {
    .lead-form__head {
      margin-inline: auto;
      text-align: center;
    }
  }

  .lead-form__head h2 {
    margin: 0 0 var(--gap-head);
    color: var(--text);
  }

  :global(.lead-form__notice) {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    padding: var(--space-md);
    border-radius: var(--radius-md);

    background: var(--glass-inset);
    box-shadow:
      inset 0 0 0 1px var(--glass-inset-hair),
      inset 0 1px 0 var(--glass-inset-rim);

    color: var(--text);

    text-wrap: pretty;
  }

  :global(.lead-form__notice)::before {
    content: '';
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: calc(0.775em - 2.5px);
    border-radius: 50%;
    background: var(--danger);
  }

  .lead-form__turnstile,
  .lead-form__status {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
  }

  .lead-form__status:empty,
  .lead-form__status[data-status-quiet] {
    position: absolute;
  }

  .lead-form__turnstile--off {
    display: none;
  }

  .lead-form__status {
    scroll-margin-bottom: 104px;
  }

  :global(.lead-form__notice-link) {
    white-space: nowrap;
    display: inline-block;
    margin-left: 6px;
    color: var(--gold);
    text-underline-offset: 4px;
  }

  .lead-form__lead {
    margin: 0;
    max-width: 54ch;
    color: var(--muted);
  }

  @media (min-width: 860px) {
    .lead-form__lead {
      max-width: none;
      text-wrap: balance;
    }
  }

  .lead-form__form {
    position: relative;

    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-md);
    border-radius: var(--radius-lg);

    background:
      var(--glass-gloss-panel),
      linear-gradient(var(--glass-tint), var(--glass-tint)),
      var(--glass-fill);

    -webkit-backdrop-filter: var(--glass-saturate);
    backdrop-filter: var(--glass-saturate);

    box-shadow: var(--glass-rim-hair), var(--glass-rim-top);
  }

  .lead-form__form::before,
  .lead-form__form::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .lead-form__form::before {
    z-index: -1;
    background: var(--glass-gloss-inner-panel);
  }

  .lead-form__form::after {
    z-index: 2;
    padding: 1px;
    background: var(--glass-edge);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  .chip-group {
    flex-wrap: nowrap;
  }

  .chip-group .chip-radio {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    padding-inline: 4px;
    text-align: center;
  }

  .chip-group .chip-radio:first-child {
    border-start-start-radius: var(--form-radius-press);
    border-end-start-radius: var(--form-radius-press);
  }

  .chip-group .chip-radio:last-child {
    border-start-end-radius: var(--form-radius-press);
    border-end-end-radius: var(--form-radius-press);
  }

  .field--direction .chip-radio:has(input:checked) {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--bg);
  }

  @media (min-width: 860px) {
    .lead-form__form {

      max-inline-size: 760px;
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-lg);
      align-items: start;

      padding-block: clamp(28px, 3.2vw, 44px);
    }

    .lead-form__form .field {
      display: contents;
    }

    .lead-form__form .field__input,
    .lead-form__form .chip-group,
    .lead-form__form .field__contact-group,
    .lead-form__form :global(.field-error) {
      grid-column: 1;
    }

    .lead-form__form :global(.field-error) {
      margin-top: calc(6px - var(--space-lg));
    }

    .lead-form__form .field--contact .field__contact-group {
      margin-top: calc(var(--space-sm) - var(--space-lg));
    }

    .consent-row,
    .lead-form__turnstile,
    .lead-form__status,
    .lead-form__form .lead-form__submit {
      grid-column: 1;
    }

    .lead-form__form .lead-form__submit {
      justify-self: stretch;
      width: auto;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border: none;
    padding: 0;
    margin: 0;
  }

  .field__label {
    color: var(--text);
  }

  .field__input,
  .field__contact-group {
    border: 1px solid transparent;
    border-radius: var(--form-radius-field);

    background: var(--glass-inset);
    box-shadow:
      inset 0 0 0 1px var(--glass-inset-hair),
      inset 0 1px 0 var(--glass-inset-rim);
  }

  .field__input {

    min-height: var(--form-h-field);
    padding-inline: 16px;
    color: var(--text);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
    font-size: 16px;
    width: 100%;
  }

  .field__input::placeholder {
    color: var(--muted);
  }

  .field__contact-group {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    margin-top: var(--space-sm);
  }

  .field__contact-group .field__input--contact {
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .field__contact-group:has(.field__input--contact:focus-visible) {
    outline: 2px solid var(--gold-light);
    outline-offset: 3px;
  }

  .field__phone-prefix {
    display: none;
    align-items: center;
    padding-inline: 16px;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
    font-size: 16px;
    flex-shrink: 0;
  }

  .field--contact:has(input[value='phone']:checked) .field__phone-prefix {
    display: flex;
  }

  .field__input--contact {
    flex: 1;
    min-width: 0;
  }

  @supports selector(:has(a)) {
    .field__input--contact:focus-visible {
      outline: none;
    }
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .chip-radio {
    position: relative;
    display: inline-flex;
    align-items: center;

    min-height: var(--form-h-chip);
    padding-inline: 16px;

    border-radius: var(--form-radius-seam);

    border: 1px solid transparent;

    background: var(--glass-inset);
    box-shadow:
      inset 0 0 0 1px var(--glass-inset-hair),
      inset 0 1px 0 var(--glass-inset-rim);
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;

    transition:
      border-color var(--motion-fast) var(--ease-charge),
      box-shadow var(--motion-fast) var(--ease-charge),
      color var(--motion-fast) var(--ease-charge);
  }

  .chip-radio__text {
    font-family: var(--font-sans);
    font-weight: var(--weight-medium);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0;

    white-space: nowrap;
  }

  .chip-radio:has(input:checked) .chip-radio__text {
    font-weight: var(--weight-bold);
  }

  .chip-radio input[type='radio'] {
    position: absolute;
    inset: -10px 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .chip-radio:has(input:hover) {
      --glass-inset-*), у
         которой пока нет отдельного «яркого» токена состояния. Первая
         попытка (`color-mix(… var(--glass-inset-hair) …, white)`) дала
         неверную арифметику: и токен, и white уже rgb(255,255,255) — мешать
         RGB нечего, а альфа интерполируется К ОПАКОВОМУ white и улетает до
         .48 вместо задуманных .12. Оставлен прямой литерал целевой альфы. */
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, .12),
        inset 0 1px 0 rgba(255, 255, 255, .16);
      color: var(--text);
    }
  }

  .chip-radio:has(input:checked) {
    border-color: rgba(241, 198, 50, 0.78);
    color: var(--gold-light);
  }

  .chip-radio:has(input:focus-visible) {
    outline: 2px solid var(--gold-light);
    outline-offset: 3px;
  }

  .chip-radio:has(input:active) {
    transform: scale(var(--press-scale));
    transition-duration: var(--motion-press);
    transition-timing-function: var(--ease-charge);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
  }

  .consent input[type='checkbox'] {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--gold);
  }

  .consent span {
    color: var(--muted);
    transition: color var(--motion-fast) var(--ease-charge);
  }

  .consent:active span {
    color: var(--text);
  }

  :global(.field-error) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0;
    color: var(--danger);
  }

  :global(.field-error)::before {
    content: '';
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  :global(.has-error) .field__input,
  :global(.has-error) .field__contact-group {
    box-shadow: inset 0 0 0 1px var(--danger);
  }

  :global(.has-error) .field--direction .chip-radio,
  .field--direction:global(.has-error) .chip-radio {

    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--danger) 45%, transparent);
  }

  .lead-form__form[hidden] {
    display: none;
  }

  :global(.lead-repeat) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);

    max-width: 46rem;
    margin-block: var(--space-xl);
    padding: var(--space-md);
    border-radius: var(--radius-md);

    background: var(--glass-inset);
    box-shadow:
      inset 0 0 0 1px var(--glass-inset-hair),
      inset 0 1px 0 var(--glass-inset-rim);

    scroll-margin-bottom: 104px;
  }

  :global(.lead-repeat__title),
  :global(.lead-repeat__body) {
    margin: 0;
  }

  :global(.lead-repeat__title) {
    color: var(--text);
  }

  :global(.lead-repeat__body) {
    max-width: 46ch;
    color: var(--muted);
  }

  :global(.lead-repeat__cta) {
    align-self: stretch;
  }

  @media (min-width: 560px) {
    :global(.lead-repeat__cta) {
      align-self: flex-start;
    }
  }

  :global(.lead-repeat__reset) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--muted);
    text-align: start;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    cursor: pointer;
    touch-action: manipulation;
    transition: color var(--motion-fast) var(--ease-charge);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.lead-repeat__reset):hover {
      color: var(--text);
    }
  }

  :global(.lead-repeat__reset):active {
    color: var(--text);
  }

  .consent-link {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--motion-fast) var(--ease-charge);
  }

  @media (hover: hover) and (pointer: fine) {
    .consent-link:hover {
      color: var(--gold-light);
    }
  }

  .consent-link:active {
    color: var(--gold-light);
  }

  .consent-link--standalone {
    display: inline-block;
    margin-top: 6px;
    margin-left: 30px;
  }

  .btn,
  :global(.lead-repeat__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--form-radius-press);
    text-decoration: none;
    cursor: pointer;
    border: none;
    white-space: normal;
    touch-action: manipulation;
    transition:
      transform var(--motion-base) var(--ease-spring),
      background-color var(--motion-fast) var(--ease-charge);
  }

  .btn-primary,
  :global(.lead-repeat__cta) {
    min-height: 54px;
    padding-inline: 26px;

    color: var(--btn-primary-text);

    box-shadow: var(--glass-rim-hair), var(--glass-rim-top);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover,
    :global(.lead-repeat__cta):hover {
      background-color: rgba(241, 198, 50, 0.78);

      -webkit-backdrop-filter: brightness(3.2) var(--glass-saturate);
      backdrop-filter: brightness(3.2) var(--glass-saturate);
    }
  }

  .btn-primary:active,
  :global(.lead-repeat__cta):active {
    transform: scale(var(--press-scale-strong));
    transition-duration: var(--motion-press);
    transition-timing-function: var(--ease-charge);
