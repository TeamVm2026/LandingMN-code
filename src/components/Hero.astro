---
import { getImage } from 'astro:assets';
import heroWide from '../assets/media/client-night-panorama.jpg';
import heroPortrait from '../assets/media/client-night-panorama-portrait.jpg';
import { Picture } from 'astro:assets';
import cloudsGroup from '../assets/media/client-clouds-group.webp';
import ContactActions from './ContactActions.astro';
import ResponseTime from './ResponseTime.astro';
import { t, type Locale } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const MELBET_MARKER = 'MELBET';
const h1Text = t(locale, 'hero.h1');
const melbetIndex = h1Text.indexOf(MELBET_MARKER);
const hasMelbet = melbetIndex >= 0;
const h1Before = hasMelbet ? h1Text.slice(0, melbetIndex) : h1Text;
const h1After = hasMelbet ? h1Text.slice(melbetIndex + MELBET_MARKER.length) : '';

const BRAND_HEAD_LENGTH = 3;
const brandHead = MELBET_MARKER.slice(0, BRAND_HEAD_LENGTH);
const brandTail = MELBET_MARKER.slice(BRAND_HEAD_LENGTH);

const PORTRAIT_SIZES = 'max(100vw, 80vh + 60px)';
const WIDE_SIZES = 'max(100vw, 236vh + 194px)';

const PORTRAIT_WIDTHS = [420, 600, 900, 1200, 1600, 2000, 2200];
const WIDE_WIDTHS = [540, 800, 1200, 1920, 2560, 3200, 3840];
const PORTRAIT_QUALITY = 42;
const WIDE_QUALITY = 46;

const [portraitAvif, portraitWebp, wideAvif, wideWebp, wideFallback] = await Promise.all([
  getImage({ src: heroPortrait, format: 'avif', widths: PORTRAIT_WIDTHS, quality: PORTRAIT_QUALITY }),
  getImage({ src: heroPortrait, format: 'webp', widths: PORTRAIT_WIDTHS, quality: PORTRAIT_QUALITY }),
  getImage({ src: heroWide, format: 'avif', widths: WIDE_WIDTHS, quality: WIDE_QUALITY }),
  getImage({ src: heroWide, format: 'webp', widths: WIDE_WIDTHS, quality: WIDE_QUALITY }),

  getImage({ src: heroWide, format: 'jpeg', width: 1200, quality: 58 }),
]);
---

<section class="hero" id="home">

  <div class="hero-media" aria-hidden="true">
    <picture>
      <source media="(max-width: 859px)" type="image/avif" srcset={portraitAvif.srcSet.attribute} sizes={PORTRAIT_SIZES} />
      <source media="(max-width: 859px)" type="image/webp" srcset={portraitWebp.srcSet.attribute} sizes={PORTRAIT_SIZES} />
      <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={WIDE_SIZES} />
      <source type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={WIDE_SIZES} />

      <img
        src={wideFallback.src}
        width={wideFallback.options.width}
        height={Math.round((heroWide.height / heroWide.width) * 1200)}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">

      <h1 class="hero-h1 type-display">
        {hasMelbet ? (
          <>{h1Before}<em>{brandHead}<span class="hero-brand-accent">{brandTail}</span></em>{h1After}</>
        ) : (
          h1Text
        )}
      </h1>

      <div class="hero-actions">

        <div class="hero-haze" aria-hidden="true" data-crosses-fold="true">
          <Picture
            src={cloudsGroup}
            formats={['avif', 'webp']}
            widths={[900]}
            sizes="239vw"
            quality={45}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <ContactActions locale={locale} variant="hero" />
      </div>

      <ResponseTime
        locale={locale}
        messageKey="hero.response_time"
        hoursKey="hero.response_hours"
        variant="plain"
      />

      <ul class="hero-stats">
        <li class="hero-stat">
          <span class="hero-stat-value">{t(locale, 'hero.stat_partners.value')}</span>
          <span class="hero-stat-label type-label">{t(locale, 'hero.stat_partners.label')}</span>
        </li>
        <li class="hero-stat">
          <span class="hero-stat-value">{t(locale, 'hero.stat_share.value')}</span>
          <span class="hero-stat-label type-label">{t(locale, 'hero.stat_share.label')}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
<div id="hero-sentinel" aria-hidden="true"></div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    min-height: 100svh;
    overflow: hidden;
  }

  .hero {
    margin-top: -74px;
    min-height: calc(100svh + 74px);
  }

  @media (min-width: 860px) {
    .hero {
      margin-top: -82px;
      min-height: calc(100svh + 82px);
      justify-content: center;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;

    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 78%,
      rgba(0, 0, 0, 0.6) 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 78%,
      rgba(0, 0, 0, 0.6) 92%,
      transparent 100%
    );

    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;

  }

  .hero-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 46%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-media :global(img) {
      animation: hero-settle var(--motion-base) var(--ease-charge) both;
    }
  }

  @keyframes hero-settle {
    from { transform: scale(1.04); }
    to   { transform: scale(1); }
  }

  .hero {

    --hero-star-left-low: 38.5%;
    --hero-star-mid-low: 32%;
    --hero-stars:
      radial-gradient(circle 5px at 76.9% 22.3%, rgba(255, 255, 255, 0.51) 0%, rgba(255, 255, 255, 0.32) 34%, rgba(255, 255, 255, 0.14) 54%, transparent 100%),
      radial-gradient(circle 2.2px at 68.1% 9.8%, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.30) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 45.7% 10.6%, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.38) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 88.6% 21.2%, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.38) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 12.5% 23.2%, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.38) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 84.4% 34.0%, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.38) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 12.2% var(--hero-star-left-low), rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0.33) 45%, transparent 100%),
      radial-gradient(circle 2.2px at 59.4% var(--hero-star-mid-low), rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.38) 45%, transparent 100%);
  }

  @media (max-width: 859px) {
    .hero {
      --hero-star-left-low: 12.4%;
      --hero-star-mid-low: 16.4%;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      var(--hero-stars),

      linear-gradient(
        180deg,

        rgba(7, 9, 11, 0.30) 0%,
        rgba(7, 9, 11, 0.10) 20%,
        rgba(7, 9, 11, 0.08) 44%,
        rgba(7, 9, 11, 0.26) 56%,
        rgba(7, 9, 11, 0.46) 68%,
        rgba(7, 9, 11, 0.72) 79%,
        var(--bg) 86%
      );
  }

  @media (max-width: 859px) {
    .hero-scrim {
      background:
        var(--hero-stars),
        linear-gradient(
        180deg,
        rgba(7, 9, 11, 0) 0%,
        rgba(7, 9, 11, 0) 10%,
        rgba(7, 9, 11, 0.12) 22%,
        rgba(7, 9, 11, 0.12) 45%,
        rgba(7, 9, 11, 0.06) 52%,
        rgba(7, 9, 11, 0.14) 58%,
        rgba(7, 9, 11, 0.22) 70%,
        rgba(7, 9, 11, 0.45) 86%,
        var(--bg) 100%
      );
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 48px), var(--page));
    margin-inline: auto;

    padding-block: clamp(96px, 22vh, 200px) clamp(104px, 16vh, 132px);
  }

  @media (min-width: 860px) {
    .hero-inner {
      padding-block: clamp(60px, 8vh, 90px)
        calc(var(--hero-overlap) + clamp(96px, 15vh, 140px));
      transform: translateY(calc(-1 * min(var(--consent-h, 0px), 22svh)));
      transition: transform var(--motion-base) var(--ease-charge);
    }
  }

  @media (min-width: 1050px) {

    .hero-inner {
      padding-block: clamp(60px, 8vh, 90px) clamp(280px, 34vh, 380px);
    }

    .hero-inner {
      transform: none;
    }
  }

  .hero-copy {
    max-width: 40rem;
  }

  @media (min-width: 1050px) {
    .hero-copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 859px) {
    .hero {
      justify-content: flex-start;
    }

    .hero-inner {
      display: flex;
      flex: 1 1 auto;
      padding-block: clamp(96px, 12.8svh, 140px) calc(74px + clamp(120px, 28svh, 300px));
    }

    .hero-copy {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      margin-inline: auto;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

  }

  .hero-h1 {
    margin: 0 0 var(--space-lg);
    color: var(--text);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  @media (max-width: 859px) {
    .hero-h1 {
      margin-top: auto;
      margin-bottom: var(--space-2xl);
    }
  }

  .hero-h1 {
    transform: skewX(-11deg);
  }

  .hero-h1 em {
    color: var(--text);
    font-style: normal;
  }

  .hero-brand-accent {
    color: var(--gold);
  }

  .hero-actions {
    display: flex;
    margin: 0 0 var(--space-md);

    position: relative;
  }

  .hero-haze {
    --haze-w: min(1200px, 190vw);
    --haze-h: 300px;
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: var(--haze-w);
    block-size: var(--haze-h);
    margin-inline-start: calc(var(--haze-w) / -2 + 170px);
    margin-block-start: calc(var(--haze-h) / -2);
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
    line-height: 0;
    opacity: 0.8;
    mix-blend-mode: lighten;

    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 clamp(64px, 6vw, 120px),
      #000 calc(100% - clamp(64px, 6vw, 120px)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 clamp(64px, 6vw, 120px),
      #000 calc(100% - clamp(64px, 6vw, 120px)),
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .hero-haze :global(picture) {
    display: block;
    position: absolute;
    inset: 0;

    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.92) 34%,
      rgba(0, 0, 0, 0.92) 62%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.92) 34%,
      rgba(0, 0, 0, 0.92) 62%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .hero-haze :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 90%;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    column-gap: var(--space-md);
    row-gap: var(--space-md);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .hero-stats {
      column-gap: var(--space-2xl);
    }
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (max-width: 859px) {
    .hero-stats {
      flex-wrap: nowrap;
      justify-content: center;
      column-gap: var(--space-md);

      margin-top: auto;
    }

    .hero-stat {
      flex: 1 1 0;
      min-width: 0;
      align-items: center;
      text-align: center;
    }

  }

  .hero-stat-value {
    font-family: var(--font-sans);
    font-weight: var(--weight-black);
    font-size: clamp(26px, calc(13.04px + 3.6vw), 44px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .hero-stat-label {
    max-width: 19ch;
    color: var(--muted);
    text-wrap: balance;
  }

  @media (max-width: 859px) {
    .hero-stat-label {
      max-width: 13.2em;
    }
  }

  @media (min-width: 860px) and (max-width: 1049px) {
    .hero-copy {
      margin-inline: auto;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-stat {
      align-items: center;
      text-align: center;
    }
  }

  @media (min-width: 1050px) {
    .hero-copy {

      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr) minmax(0, 1fr);
      column-gap: clamp(24px, 3vw, 56px);
      align-items: center;
      justify-items: center;
      text-align: center;
    }

    .hero-h1 {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: var(--space-lg);
    }

    .hero-actions {
      grid-column: 2;
      grid-row: 2;
      justify-content: center;
    }

    .hero-copy :global(.hero-status) {
      grid-column: 2;
      grid-row: 3;
    }

    .hero-stats {
      grid-column: 1 / -1;
      grid-row: 1;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      align-items: center;
      column-gap: 0;
      margin: 0;
    }

    .hero-stat {
      max-width: 15rem;
      align-items: center;
      text-align: center;
    }

    .hero-stat-label {
      max-width: none;
    }
  }

  #hero-sentinel {
    height: 1px;

    background-color: var(--bg);
  }

  #hero-sentinel {
    margin-bottom: calc(-1 * var(--hero-overlap));
  }
</style>
