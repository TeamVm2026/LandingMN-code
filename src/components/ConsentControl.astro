---
import { t } from '../i18n/t';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div
  class="consent-control"
  data-consent-control
  hidden
  role="group"
  aria-label={t(locale, 'consent.control_label')}
  data-state-on={t(locale, 'consent.state_on')}
  data-state-off={t(locale, 'consent.state_off')}
  data-action-off={t(locale, 'consent.action_off')}
  data-action-on={t(locale, 'consent.action_on')}
>

  <p class="consent-control__state type-body" data-consent-state aria-live="polite"></p>

  <button type="button" class="consent-control__btn type-body-bold" data-consent-toggle></button>
</div>

<style>
  .consent-control {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }

  .consent-control[hidden] {
    display: none;
  }

  .consent-control__state {
    margin: 0;
    color: var(--text);
  }

  .consent-control__btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: var(--space-md);
    border-radius: var(--radius-control);
    border: none;
    background-color: var(--btn-secondary-bg);
    background-image: var(--glass-gloss);
    -webkit-backdrop-filter: var(--glass-saturate);
    backdrop-filter: var(--glass-saturate);
    box-shadow: var(--glass-rim-hair), var(--glass-rim-top);
    color: var(--btn-secondary-text);
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;

    transition:
      transform var(--motion-base) var(--ease-spring),
      background-color var(--motion-fast) var(--ease-charge);
  }

  .consent-control__btn::before,
  .consent-control__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .consent-control__btn::before {
    z-index: -1;
    background: var(--glass-gloss-inner);
  }

  .consent-control__btn::after {
    z-index: 2;
    padding: 1px;
    background: var(--glass-edge);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  @media (hover: hover) and (pointer: fine) {
    .consent-control__btn:hover {
      background-color: var(--btn-secondary-bg-hover);
    }
  }

  .consent-control__btn:active {
    transform: scale(var(--press-scale-strong));
    background-color: var(--btn-secondary-bg-active);
    transition-duration: var(--motion-press);
    transition-timing-function: var(--ease-charge);
  }

  @media (prefers-reduced-transparency: reduce) {
    .consent-control__btn {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border: var(--btn-secondary-border);
    }

    .consent-control__btn::before,
    .consent-control__btn::after {
      opacity: 0;
    }
  }
</style>
