---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {

  src: ImageMetadata;

  modifier: string;

  sizes: string;

  widths: number[];

  eager?: boolean;

  cover?: boolean;

  repeat?: number;
}

const { src, modifier, sizes, widths, eager = false, cover = false, repeat = 1 } = Astro.props;
const copies = Array.from({ length: Math.max(1, repeat) });
---

<div
  class:list={['scene-layer', modifier, { 'scene-layer--cover': cover }]}
  aria-hidden="true"
  data-crosses-fold={eager ? 'true' : undefined}
>

  <div class="scene-layer__plate">
    {
      copies.map(() => (
        <Picture
          src={src}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          quality={40}
          alt=""
          loading="lazy"
          fetchpriority="low"
          decoding="async"
        />
      ))
    }
  </div>
</div>

<style is:global>
  .scene-layer {
    position: absolute;

    left: 0;
    right: 0;
    top: var(--sl-top);
    height: var(--sl-h);

    z-index: -1;
    pointer-events: none;

    overflow: hidden;
    line-height: 0;
    opacity: var(--sl-opacity, 1);

    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    transform: var(--sl-flip, none);
  }

  .scene-layer__plate {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: var(--sl-w);
    height: 100%;
  }

  .scene-layer picture {
    display: block;
  }

  .scene-layer img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scene-layer--cover picture,
  .scene-layer--cover img {
    width: 100%;
    height: 100%;
  }

  .scene-layer--cover img {
    object-fit: cover;
  }

  .scene-layer--cover picture:first-child {
    height: var(--sl-first, 100%);
  }

  .scene-layer--cover picture:not(:first-child),
  .scene-layer--cover picture:not(:first-child) img {
    height: auto;
  }

  .scene-layer picture:nth-child(n + 3) {
    margin-top: calc(-1 * var(--sl-tile-lap, 0px));
  }

  .scene-layer picture:nth-child(2) {
    margin-top: var(--sl-tail-start, 0px);
  }

  .scene-layer picture:nth-child(n + 2) {
    opacity: var(--sl-tail-opacity, 1);
  }
</style>
