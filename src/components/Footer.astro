---
import { t } from '../i18n/t';
import { PAGE_ROUTES, type Locale } from '../i18n/routes';
import { config } from '../config';

import TelegramIcon from './icons/footer/FooterTelegramIcon.astro';
import FacebookPageIcon from './icons/footer/FooterFacebookIcon.astro';
import InstagramIcon from './icons/footer/FooterInstagramIcon.astro';

interface Props {
  locale: Locale;

  onScene?: boolean;
}

const { locale, onScene = false } = Astro.props;
---

<footer class:list={['site-footer', { 'site-footer--scene': onScene }]}>

  <div class="site-footer__container">

    <span class="site-footer__badge type-body">{t(locale, 'footer.age_badge')}</span>

    <div class="site-footer__brand">
      <a class="site-footer__privacy type-body" href={PAGE_ROUTES.privacy[locale]}>
        {t(locale, 'footer.privacy_link')}
      </a>
    </div>

    <div class="site-footer__legal">
      <p class="site-footer__copyright type-body">
        <span>{t(locale, 'footer.copyright')}</span>
        <span class="site-footer__legal-note">{t(locale, 'footer.legal_note')}</span>
      </p>
    </div>

    <div class="site-footer__meta">
      <div class="site-footer__social">
        <a
          class="site-footer__icon site-footer__icon--contact"
          href={config.tgContactUrl}
          target="_blank"
          rel="noopener noreferrer"
          title={t(locale, 'footer.contact_manager')}
        >
          <TelegramIcon />
          <span class="visually-hidden">{t(locale, 'footer.contact_manager')}</span>
        </a>
      </div>

      <div class="site-footer__channels" role="group" aria-label={t(locale, 'footer.follow_label')}>
        <a
          class="site-footer__icon"
          href={config.brandChannels.instagram}
          target="_blank"
          rel="noopener noreferrer"
          title={t(locale, 'footer.channel_instagram')}
        >
          <InstagramIcon />
          <span class="visually-hidden">{t(locale, 'footer.channel_instagram')}</span>
        </a>
        <a
          class="site-footer__icon"
          href={config.brandChannels.facebook}
          target="_blank"
          rel="noopener noreferrer"
          title={t(locale, 'footer.channel_facebook')}
        >
          <FacebookPageIcon />
          <span class="visually-hidden">{t(locale, 'footer.channel_facebook')}</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl);
  }

  .site-footer--scene {
    background: transparent;
    position: relative;
    z-index: 41;
  }

  .site-footer__container {
    width: min(calc(100% - 48px), var(--page));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 860px) {
    .site-footer__container {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-lg);
      row-gap: var(--space-sm);
    }

    .site-footer__brand {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }

    .site-footer__legal {
      grid-column: 1;
      grid-row: 2;
    }

    .site-footer__badge {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .site-footer__meta {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
  }

  .site-footer__channels {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-footer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
    color: var(--muted);
    background: transparent;
    touch-action: manipulation;
    transition: color var(--motion-fast) var(--ease-charge),
      transform var(--motion-base) var(--ease-spring);
  }

  .site-footer__icon--contact {
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__icon:hover {
      color: var(--text);
    }

    .site-footer__icon--contact:hover {
      color: var(--gold);
    }
  }

  .site-footer__icon:active {
    transform: scale(var(--press-scale-strong));
    transition-duration: var(--motion-press);
    transition-timing-function: var(--ease-charge);
  }

  .site-footer__icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .site-footer__legal {
    max-width: 480px;
  }

  .site-footer__legal p,
  .site-footer__badge,
  .site-footer__privacy {
    margin: 0;
    color: var(--muted);
  }

  .site-footer__legal-note::before {
    content: '·';
    padding-inline: 0.5ch;
    color: var(--line-strong);
  }

  .site-footer__badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: var(--radius-control);
    font-weight: var(--weight-bold);

    background: var(--glass-inset);
    box-shadow:
      inset 0 0 0 1px var(--glass-inset-hair),
      inset 0 1px 0 var(--glass-inset-rim);
  }

  .site-footer__privacy {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__privacy:hover {
      color: var(--text);
    }
  }

  .site-footer__privacy:active {
    color: var(--text);
  }
</style>
