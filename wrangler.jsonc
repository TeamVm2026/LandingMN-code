// wrangler.jsonc — repo root
// Source: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landingmn",
  "pages_build_output_dir": "./dist",

  // ─── ПРАВИЛО ДВУХ ПОТОЛКОВ ────────────────────────────────────────────────
  // `compatibility_date` не может быть больше НИ (а) даты, поддерживаемой
  // установленным бинарником workerd, НИ (б) сегодняшней даты по UTC.
  //
  // Нарушения дают ДВЕ РАЗНЫЕ ошибки от ДВУХ РАЗНЫХ программ, и по тексту всегда
  // видно, какой именно потолок задет:
  //   (а) workerd: `This Worker requires compatibility date "…", but the newest
  //       date supported by this server binary is "…"`
  //       → лечится подъёмом wrangler (workerd приезжает вместе с ним);
  //   (б) wrangler: `Compatibility date "…" is in the future and unsupported`
  //       → не лечится ничем, кроме наступления этой даты.
  // Спутать их — значит месяц искать несуществующую проблему в тулчейне.
  //
  // ⚠️ `workerd --version` печатает дату, которая потолком НЕ ЯВЛЯЕТСЯ. Замерено
  // на двух разных тулчейнах, и оба раза потолок оказался ПОЗЖЕ версии бинарника:
  //   wrangler 4.120.0 / workerd 1.20260801.1 → --version печатает 2026-08-01,
  //                                             фактический потолок 2026-08-08;
  //   wrangler 4.124.0 / workerd 1.20260815.1 → версия 2026-08-15,
  //                                             а 2026-08-20 стартует нормально.
  // Вывод: потолок (а) определяется ТОЛЬКО прогоном, не именем пакета и не --version.
  //
  // Замер на текущем тулчейне (wrangler 4.124.0 / workerd 1.20260815.1),
  // `wrangler pages dev` в изолированном каталоге:
  //   2026-08-19 → Ready on http://127.0.0.1:8791
  //   2026-08-20 → Ready on http://127.0.0.1:8792
  //   2026-08-21 → wrangler: "is in the future and unsupported"
  //   2026-09-01 → wrangler: "is in the future and unsupported"
  // То есть на этом тулчейне первым срабатывает потолок (б), а потолок (а) лежит
  // не ближе 2026-08-20 и дальше НЕ ИЗМЕРИМ: проверка wrangler отрабатывает
  // раньше, чем стартует workerd, и заслоняет её.
  //
  // Значение ниже проверено прогоном. Гнаться за сегодняшним числом не нужно и
  // вредно: `compatibility_date` фиксирует НАБОР ПОВЕДЕНИЙ рантайма, а не
  // «свежесть» проекта, и её единственный смысл — воспроизводимость. Поднимать
  // имеет смысл только ради конкретного нового поведения и только прогоном
  // `wrangler pages dev`, а не арифметикой от текущей даты.
  "compatibility_date": "2026-08-19",

  // ─── Журнал лидов (LEAD-04) ───────────────────────────────────────────────
  // Биндинг обязан жить ЗДЕСЬ, а не в панели Cloudflare. У проекта Pages уже
  // есть `wrangler_config_hash`, а документация формулирует последствие прямо:
  // «This file becomes the source of truth when used, meaning that you can not
  // edit the same fields in the dashboard once you are using this file».
  // С этого момента правка тех же полей в панели просто не применяется — и
  // выглядит это как «я всё настроил, а оно не работает».
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "00000000000000000000000000000000"
    }
  ],

  // ⚠️ ДУБЛЬ НИЖЕ ОБЯЗАТЕЛЕН, А НЕ ИЗБЫТОЧЕН. Верхнеуровневый `kv_namespaces`
  // покрывает локальную разработку и production, но НЕ превью-деплои: `env.preview`
  // перекрывает верхний уровень, а не дополняет его. Без собственного блока превью
  // осталось бы вообще без хранилища — и лиды терялись бы ровно там, где план
  // 04-11 их проверяет, то есть отказ был бы найден в последнюю очередь.
  //
  // ПРАВИЛО НЕНАСЛЕДУЕМЫХ КЛЮЧЕЙ (`kv_namespaces`, `vars` и другие):
  // «if any one non-inheritable key is overridden for any environment …, all
  // non-inheritable keys must also be specified in the environment configuration
  // and overridden». Практическое следствие на будущее: в день, когда в
  // `env.preview` появится `vars` (или любой другой ненаследуемый ключ), сюда
  // придётся перенести И ВСЕ остальные ненаследуемые ключи, включая этот блок.
  // Не сделать этого — значит молча остаться без KV на превью.
  "env": {
    "preview": {
      "kv_namespaces": [
        {
          "binding": "LEADS",
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  }
}
